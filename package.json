{
    "name": "shakti-express-typescript-template",
    "version": "0.0.1",
    "main": "src/index.ts",
    "license": "",
    "scripts": {
        "build": "tsc && tsc-alias && tsx src/utils/build.utils.ts",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "dev": "tsx watch --clear-screen=false src/index.ts",
        "lint": "eslint src/",
        "format": "prettier ./src --write",
        "format:checker": "prettier ./src --check",
        "spell": "cspell lint ./src/",
        "test": "vitest run",
        "check": "pnpm lint && pnpm format:checker && pnpm spell && pnpm test",
        "prepare": "husky"
    },
    "dependencies": {
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "lorin": "^2.0.5",
        "mongoose": "^9.7.0",
        "multer": "2.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/multer": "^2.1.0",
        "@types/supertest": "^7.2.0",
        "@typescript-eslint/eslint-plugin": "^8.61.1",
        "@typescript-eslint/parser": "^8.61.1",
        "cspell": "^10.0.1",
        "eslint": "^10.5.0",
        "globals": "^17.6.0",
        "husky": "^9.1.7",
        "prettier": "^3.8.4",
        "supertest": "^7.2.2",
        "tsc-alias": "^1.8.17",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.1",
        "vitest": "^4.1.9"
    },
    "packageManager": "pnpm@10.12.1"
}
