{
    "name": "shakti-express-typescript-template",
    "version": "0.0.1",
    "main": "src/index.ts",
    "license": "",
    "scripts": {
        "build": "tsc && tsc-alias && tsx src/core/utils/build.utils.ts",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "dev": "tsx watch src/run.ts --clear-screen=false",
        "lint": "eslint src/",
        "format": "prettier ./src --write",
        "format:checker": "prettier ./src --check",
        "spell": "cspell lint ./src/",
        "test": "vitest run",
        "check": "pnpm lint && pnpm format:checker && pnpm spell && pnpm test",
        "prepare": "husky",
        "module:create": "tsx src/core/utils/create-module.utils.ts"
    },
    "dependencies": {
        "cors": "^2.8.6",
        "dompurify": "^3.4.17",
        "dotenv": "^18.0.10",
        "express": "^5.3.0",
        "lorin": "^2.0.5",
        "marked": "^18.2.0",
        "mongoose": "^9.12.1",
        "multer": "2.5.0",
        "swagger-ui-express": "^5.0.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/multer": "^2.3.0",
        "@types/supertest": "^7.2.1",
        "@types/swagger-ui-express": "^4.1.8",
        "@typescript-eslint/eslint-plugin": "^8.72.2",
        "@typescript-eslint/parser": "^8.72.2",
        "@typescript/native": "npm:typescript@^7.0.2",
        "cspell": "^10.4.1",
        "eslint": "^10.14.0",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "prettier": "^3.9.10",
        "supertest": "^7.3.2",
        "tsc-alias": "^1.9.10",
        "tsx": "^4.23.15",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.72.2",
        "vitest": "^5.1.0"
    },
    "packageManager": "pnpm@10.12.1",
    "engines": {
        "node": "^24.18.0"
    }
}
